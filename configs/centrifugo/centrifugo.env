CENTRIFUGO_LOG_LEVEL=info
CENTRIFUGO_BROKER_ENABLED=true
CENTRIFUGO_BROKER_TYPE=postgres
CENTRIFUGO_BROKER_POSTGRES_DSN=${POSTGRES_DSN}
CENTRIFUGO_BROKER_POSTGRES_USE_NOTIFY=true
CENTRIFUGO_CONTROLLER_ENABLED=true
CENTRIFUGO_CONTROLLER_TYPE=postgres
CENTRIFUGO_CONTROLLER_POSTGRES_DSN=${POSTGRES_DSN}
CENTRIFUGO_CONTROLLER_POSTGRES_USE_NOTIFY=true
CENTRIFUGO_CHANNEL_WITHOUT_NAMESPACE_PRESENCE=true
CENTRIFUGO_CHANNEL_WITHOUT_NAMESPACE_JOIN_LEAVE=true
CENTRIFUGO_CHANNEL_WITHOUT_NAMESPACE_FORCE_PUSH_JOIN_LEAVE=true
CENTRIFUGO_CHANNEL_WITHOUT_NAMESPACE_ALLOW_SUBSCRIBE_FOR_CLIENT=true
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=${BETTER_AUTH_SECRET}
CENTRIFUGO_CLIENT_TOKEN_ISSUER=${BETTER_AUTH_URL}
CENTRIFUGO_CLIENT_TOKEN_AUDIENCE=centrifugo
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=http://localhost:5173
CENTRIFUGO_HTTP_API_KEY=${CENTRIFUGO_API_KEY}
CENTRIFUGO_ADMIN_ENABLED=false

{
  "name": "@chat/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm clean:build && tsup-node src/server.ts --minify --splitting --sourcemap --treeshake",
    "clean": "rimraf dist coverage",
    "clean:build": "rimraf dist",
    "clean:coverage": "rimraf coverage",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "tsx watch src/server.ts",
    "fix": "biome fix src/**/*.ts",
    "format": "biome format src/**/*.ts",
    "lint": "biome lint src/**/*.ts",
    "start": "node dist/server.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@chat/centrifugo": "workspace:*",
    "@chat/contracts": "workspace:*",
    "@fastify/auth": "^5.0.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "better-auth": "^1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "fast-jwt": "^6.2.4",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "jose": "^6.2.3",
    "nanoid": "^6.0.0",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^1.0.0-rc.4",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
